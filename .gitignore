# 依赖包，体积巨大，绝对不要上传
node_modules/

# vite打包产物（就是你截图里一堆dist里的js/css）
dist/
dist-ssr/

# 本地环境变量（里面可能有接口密钥、账号密码，敏感！）
.env.local
.env.*.local

# 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器缓存（VSCode、WebStorm）
.idea/
.vscode/
*.swp
*.swo


# 临时文件、缓存
*.tmp
*.bak

# 测试覆盖率
coverage/


# Playwright MCP 抓取的页面快照与控制台日志（本地调试产物）
.playwright-mcp/

# 招标文件等本地参考资料与 Office 锁文件（不进仓库）
*.docx
~$*.docx
问题描述_extract.txt
