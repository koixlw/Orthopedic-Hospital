# 依赖包，体积巨大，绝对不要上传
node_modules/

# vite打包产物（就是你截图里一堆dist里的js/css）
dist/
dist-ssr/

# 本地环境变量（里面可能有接口密钥、账号密码，敏感！）
.env.local
.env.*.local

# 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器缓存（VSCode、WebStorm）
.idea/
.vscode/
*.swp
*.swo


# 临时文件、缓存
*.tmp
*.bak

# 测试覆盖率
coverage/

docs
